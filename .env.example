PORT=3001
HOST=127.0.0.1
# Render: HOST=0.0.0.0 and TRUST_PROXY=1 behind its single ingress proxy.
TRUST_PROXY=loopback
APP_URL=http://127.0.0.1:5173
WEBHOOK_BASE_URL=
DEMO_MODE=true
# Required when DEMO_MODE=false. Use a Supabase connection pooler URL as appropriate.
DATABASE_URL=postgresql://postgres:password@localhost:5432/relay
JWT_SECRET=replace-with-at-least-32-random-characters
# Base64-encoded 32-byte key. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
SHOPIFY_APP_SECRET=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Serve the built dashboard from the API when testing through an HTTPS tunnel.
SERVE_WEB=false
SHOPIFY_API_VERSION=2026-10
META_API_VERSION=v24.0
# Keep false until live messaging has been explicitly configured.
OUTBOUND_ENABLED=false
# Merchant sender credentials, approved templates and sandbox authorizations belong
# in Relay's encrypted tenant settings, not environment variables.

# Additional trusted dashboard origins, separated by commas (local development only).
ALLOWED_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
